{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm check)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec next:*)",
      "Bash(pnpm outdated)",
      "Bash(pnpm view:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(vercel ls:*)",
      "Bash(vercel inspect:*)",
      "Bash(vercel env ls:*)",
      "Bash(lighthouse:*)",
      "Bash(curl -s https://www.vitrincabinetry.com:*)",
      "Bash(curl -sI https://www.vitrincabinetry.com:*)",
      "Bash(curl -s http://localhost:*)"
    ],
    "deny": [
      "Read(./.env.local)"
    ]
  }
}
