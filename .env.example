# ─────────────────────────────────────────────────────────────────────────────
# Vitrin Cabinetry — Environment Variables
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# Server-only secrets must NOT have the NEXT_PUBLIC_ prefix.
# ─────────────────────────────────────────────────────────────────────────────

# --- Business NAP -----------------------------------------------------------
# Phone and email are NOT env vars — they live in src/lib/site.ts as the single
# source of truth for the footer, contact page, and JSON-LD. Edit them there.
NEXT_PUBLIC_BUSINESS_STREET="123 Main St, Suite 100"

# --- Social profile URLs (used in JSON-LD `sameAs` for entity disambiguation)
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_HOUZZ_URL=""
NEXT_PUBLIC_GOOGLE_PROFILE_URL=""

# --- Analytics ---------------------------------------------------------------
# Google Analytics 4 measurement ID — starts with "G-"
# Get it at: https://analytics.google.com → Admin → Data Streams → Web
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Microsoft Clarity project ID — alphanumeric string
# Get it at: https://clarity.microsoft.com → New Project
NEXT_PUBLIC_CLARITY_ID=""

# --- Contact form lead delivery (PxlPeak) ------------------------------------
# Leads are forwarded to the PxlPeak platform (same format as
# vmpowerconstruction.com): storage, fraud scoring, owner notification,
# and customer auto-reply all happen there. Notification recipients are
# configured per-site in PxlPeak (v2.sites.settings.emailReceivers).
PXLPEAK_API_URL="https://pxlpeak.com"
# Publishable API key scoped to the vitrincabinetry.com site in PxlPeak
PXLPEAK_API_KEY="pk_live_..."
